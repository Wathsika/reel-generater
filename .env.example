# ---------------------------------------------------------------------------
# Copy to .env (local laptop) — on GitHub use Settings > Secrets instead.
# The pipeline reads os.environ first, then .env, then state/tokens.json.
# ---------------------------------------------------------------------------

# ---- LLM / transcription (free tiers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional local fallbacks
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
# WHISPER_BACKEND=local          # groq (default) | local

# ---- Storage for finished clips (pick ONE backend) ----
# STORAGE_BACKEND=s3 | nextcloud | r2
# Auto-detected if blank: S3_ENDPOINT -> s3, NC_URL -> nextcloud, else r2.
# Meta/TikTok fetch the clip themselves, so the URL must be public HTTPS
# serving the raw file (Content-Type: video/mp4), with NO redirect or login.
STORAGE_BACKEND=

# -- Option A: S3-compatible object storage (MINIO ON YOUR VPS - recommended) --
# Also works for Backblaze B2, Wasabi, Hetzner, etc.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clips
S3_REGION=us-east-1
# true for MinIO / most self-hosted, false for AWS/B2
S3_PATH_STYLE=true
# Public HTTPS base that serves the bucket (reverse proxy or CDN), e.g.
# https://clips.yourdomain.com  (must map to the bucket root)
S3_PUBLIC_BASE=

# -- Option B: Nextcloud (uses WebDAV + public share links) --
# NOTE: Nextcloud share links redirect to /download. Meta generally rejects
# redirects, so prefer Option A. Set a direct-download template if yours works.
NC_URL=
NC_USER=
NC_APP_PASSWORD=
NC_FOLDER=Clips
NC_DIRECT_TEMPLATE={share}/download

# -- Option C: Cloudflare R2 (paid card required, 10 GB free tier) --
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clips
R2_PUBLIC_BASE=

# ---- Instagram (Graph API) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional if you keep the token in state/tokens.json
# IG_APP_ID=
# IG_APP_SECRET=

# ---- Facebook Reels (Graph API, Page token) ----
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ---- TikTok (Content Posting API) ----
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_REDIRECT_URI=https://localhost/callback
# access/refresh tokens live in state/tokens.json after OAuth

# ---- GitHub (dispatch + review issues) ----
# GITHUB_TOKEN / GH_TOKEN are provided by Actions automatically.
# For laptop runs, create a PAT with repo scope and set it here:
# GH_TOKEN=

# ---- Ops knobs ----
# CLIPS_PER_DAY=6
# AUTO_APPROVE=false
# MAX_CONCURRENT_RENDERS=1
